{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whisp",
  "version": "0.1.1",
  "identifier": "com.whisp.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "recorder",
        "title": "whisp-recorder",
        "url": "/?window=recorder",
        "width": 576,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "resizable": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "main",
        "title": "whisp",
        "url": "/?window=main",
        "width": 1100,
        "height": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "updater": {
      "active": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/djeel/whisp/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMDQzRDE5RTM1OEZENzcKUldSMy9WampHVDBFUFIyL01obDVFbFA4QkxWSW55UzYvUnRxdUFFQ0haZ2Z1Sjh3c3h0YTkzTEsK"
    }
  }
}
